<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<fx:root alignment="TOP_RIGHT"
         maxWidth="1.7976931348623157E308"
         spacing="8.0"
         type="javafx.scene.layout.HBox"
         xmlns="http://javafx.com/javafx/25"
         xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <VBox maxWidth="310.0" spacing="8.0" styleClass="dialog-content">
            <children>
                <Label fx:id="welcomeBanner"
                       managed="false"
                       minHeight="-Infinity"
                       styleClass="welcome-banner"
                       text="Banner"
                       visible="false" />
                <Label fx:id="dialog"
                       maxWidth="282.0"
                       minHeight="-Infinity"
                       text="Message"
                       wrapText="true" />
            </children>
        </VBox>
        <Label fx:id="displayPicture"
               alignment="CENTER"
               minHeight="44.0"
               minWidth="44.0"
               prefHeight="44.0"
               prefWidth="44.0"
               styleClass="avatar-placeholder"
               text="N" />
    </children>
    <padding>
        <Insets bottom="5.0" left="10.0" right="10.0" top="5.0" />
    </padding>
</fx:root>
